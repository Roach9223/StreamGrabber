{
  "name": "streamgrabber",
  "version": "1.0.0",
  "description": "Paste a live-sport aggregator match URL, get the raw HLS stream in mpv with no ads.",
  "private": true,
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "resolve": "node resolve.js",
    "icon": "node tools/make-icon.js",
    "build": "node tools/build.js"
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0",
    "rcedit": "^5.0.2"
  },
  "pkg": {
    "targets": ["node22-win-x64"],
    "outputPath": "dist",
    "assets": [
      "public/**/*",
      "node_modules/playwright-core/**/*"
    ]
  }
}
